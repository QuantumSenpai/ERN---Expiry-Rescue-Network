# =============================================================================
# ERN (Expiry Rescue Network) — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your live .env to version control!
# =============================================================================

# --- Backend Database (Neon Serverless Postgres) ---
# Neon connection string with sslmode=require (provided in Neon dashboard)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternatively, individual connection parameters:
# DB_HOST=ep-sample-pooler.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASS=YOUR_PASSWORD
# DB_SSLMODE=require

# --- Security & JWT ---
# Secret key for HS256 JWT signature verification (minimum 32 random characters)
JWT_SECRET=ern_super_secret_jwt_key_change_in_production_2026_xyz

# --- CORS Settings ---
# Allowed frontend origin (* for local dev, or https://your-ern-frontend.vercel.app for production)
CORS_ALLOWED_ORIGIN=*

# --- Frontend Client Configuration ---
# Base URL for API calls made from Vite React client
VITE_API_URL=http://localhost:8000/api
